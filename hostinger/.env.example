APP_NAME=WorkTrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://worktrack.blackpurple.in
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=replace_with_hostinger_database_name
DB_USERNAME=replace_with_hostinger_database_user
DB_PASSWORD="replace_with_database_password"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=worktrack_session
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=replace_with_smtp_host
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME=WorkTrack

# Absolute private paths; leave unset to use storage/app/private.
# WORKTRACK_UPLOAD_PATH=/home/ACCOUNT/domains/blackpurple.in/worktrack/storage/app/private/uploads
# WORKTRACK_APK_PATH=/home/ACCOUNT/domains/blackpurple.in/worktrack/storage/app/private/downloads/worktrack.apk
